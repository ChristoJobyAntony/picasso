stylize/magenta_arbitrary-image-stylization-v1-256_2/
__pycache__/
# Python venv leftovers — anchored to repo root so they don't shadow
# app/src/lib/ on case-insensitive filesystems (macOS).
/Include/
/Lib/
/Scripts/
/share/
/pyvenv.cfg
/poetry.lock
app/node_modules
app/build/*
app/.tsc-cache/
*.tsbuildinfo

# Terraform — local state and any private OCI inputs. The lockfile
# (.terraform.lock.hcl) is intentionally NOT ignored: commit it so CI
# and other contributors get the same provider versions.
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup
infra/terraform/terraform.tfvars
infra/terraform/*.tfplan