# Copy to terraform.tfvars (gitignored) and fill in.

# --- Cloudflare ---
# Create a token at https://dash.cloudflare.com/profile/api-tokens
# Permissions:
#   Account.Cloudflare Pages : Edit
#   Zone.DNS                 : Edit
# Account resources : Include : <your account>
# Zone resources    : Include : Specific zone : christojobyantony.me
#
# cloudflare_account_id and cloudflare_zone_id come from the Cloudflare
# dashboard — both are shown in the right sidebar of any zone's
# overview page.

cloudflare_api_token  = "your-cloudflare-api-token"
cloudflare_account_id = "your-32-char-account-id"
cloudflare_zone_id    = "your-32-char-zone-id"
cloudflare_zone_name  = "christojobyantony.me"

# Defaults below are fine; uncomment to override.
# project_name      = "picasso"
# site_subdomain    = "picasso"        # use "@" for apex
# production_branch = "master"
# github_owner      = "ChristoJobyAntony"
# github_repo_name  = "picasso"
